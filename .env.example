# ===========================================================================
# docker-compose / Coolify environment
#
# Local:   cp .env.example .env   and fill in the REQUIRED block.
# Coolify: paste these into the resource's Environment Variables tab instead.
#
# docker-compose.yml hands each variable to only the service that needs it.
# The WhatsApp container never receives SAKAI_PASS or TELEGRAM_TOKEN.
#
# Leave an optional line blank and the service uses its built-in default.
# Per-service reference: Sakai-Assignment-Alerts/.env.example and
# WhatsappBot/.env.example.
# ===========================================================================


# ---------------------------------------------------------------------------
# REQUIRED - scraper (Telegram channel)
# ---------------------------------------------------------------------------
SAKAI_USER=10XXXXXXX
SAKAI_PASS=your_sakai_password
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# Strongly recommended: current term, e.g. S1-2526 or 2526. Blank = all
# courses, including old ones.
ACTIVE_TERM=


# ---------------------------------------------------------------------------
# REQUIRED - WhatsApp bot
# ---------------------------------------------------------------------------
# Admin numbers, comma-separated, digits with country code. Only these can run
# commands. Send /id to the bot if you are unsure what to put here.
ADMIN_NUMBERS=233200000000


# ---------------------------------------------------------------------------
# Linking the bot's account (one time) - see WhatsappBot/README.md
# ---------------------------------------------------------------------------
# qr = scan a QR from the logs | pairing = type an 8-char code on the phone
LOGIN_METHOD=pairing
# Required for pairing: the BOT's number, digits only with country code, no "+" (e.g. 233200000000)
BOT_NUMBER=
PAIRING_CODE=


# ---------------------------------------------------------------------------
# AI Assistant (Choose either Gemini or Free Llama via Groq)
# ---------------------------------------------------------------------------
# Option A: Gemini (Default is gemini-1.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Option B: Free Llama 3.3 via Groq (Get free key from console.groq.com)
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
GEMINI_THINKING_BUDGET=0

LLM_RATE_LIMIT=5
LLM_RATE_WINDOW_MINUTES=60

# Hard monthly token ceiling. Set this to something you are willing to spend.
LLM_MONTHLY_CAP=1000000
LLM_MONTHLY_COST_CAP=0

# Placeholders used only to estimate cost - verify them at
# https://ai.google.dev/pricing or the cost figure will be wrong.
LLM_INPUT_PRICE_PER_MTOK=0.30
LLM_OUTPUT_PRICE_PER_MTOK=2.50

LLM_CONTEXT_TURNS=6
LLM_MAX_REPLY_CHARS=1200


# ---------------------------------------------------------------------------
# Behaviour (optional)
# ---------------------------------------------------------------------------
COMMAND_PREFIX=/

# Randomised delay between automated sends. The main anti-ban control -
# do not set these to 0.
SEND_MIN_DELAY_MS=3500
SEND_MAX_DELAY_MS=9000

OUTBOX_POLL_MS=5000
QUESTIONSDEY_URL=https://questionsdey.com
BOT_NAME=AssignmentDey
SAKAI_BASE=https://sakai.ug.edu.gh
LOG_LEVEL=info

# Size cap for the hand-off queue before it rotates, in bytes.
OUTBOX_MAX_BYTES=2000000
