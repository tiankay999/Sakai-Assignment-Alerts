# ===========================================================================
# WhatsApp bot (Baileys + Gemini Flash)
#
#   cp .env.example .env     then fill in the REQUIRED block below.
#
# Every other value has a working default - leave it alone unless you want to
# change the behaviour described in the comment.
#
# This file is git-ignored once copied to .env. Never commit real values.
# ===========================================================================


# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Shared volume with the Python scraper. MUST match the scraper's DATA_DIR,
# or the bot will never see the alerts it is supposed to deliver.
# Docker: /data   |   running locally: a real path, e.g. ./data
DATA_DIR=/data

# Admin phone numbers, comma-separated, digits only with country code.
# ONLY these numbers can run commands. Everyone else is ignored silently.
# Spaces and "+" are stripped, so "+233 20 000 0000" also works.
# Not sure what to put? Send "/id" to the bot and it tells you.
ADMIN_NUMBERS=233200000000


# ---------------------------------------------------------------------------
# Linking the bot's WhatsApp account (one time)
# ---------------------------------------------------------------------------
# Use a DEDICATED SECOND NUMBER for the bot. Never your personal number -
# automated WhatsApp accounts carry a real ban risk.
#
# Auth state is saved to $DATA_DIR/baileys_auth, so you only link once as long
# as that directory survives. Delete it to force a re-link.

# qr      = a QR code is printed in the logs; scan it with the bot's phone
# pairing = an 8-character code is printed; type it on the bot's phone under
#           Linked devices > Link a device > "Link with phone number instead"
#
# QR is the more reliable path and the default. Pairing is easier when the
# server is remote and the phone is in your hand.
LOGIN_METHOD=qr

# Required for LOGIN_METHOD=pairing: the BOT's own number, digits only, with
# country code, no "+", spaces or leading zero. e.g. 233200000000
# If this is empty while LOGIN_METHOD=pairing, the bot warns and uses QR.
BOT_NUMBER=

# Optional: pin a specific pairing code instead of a random one.
# Must be exactly 8 characters (A-Z and 2-9). Empty = random.
PAIRING_CODE=


# ---------------------------------------------------------------------------
# Gemini Flash assistant
# ---------------------------------------------------------------------------
# Leave GEMINI_API_KEY empty and the assistant simply stays silent - alerts,
# digests, /deadlines and all admin commands keep working with zero AI calls.

# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Flash-class model. gemini-1.5-flash is NOT recommended: new API projects
# can no longer access it.
GEMINI_MODEL=gemini-2.5-flash

# 2.5-series models bill "thinking" tokens against your cap below. 0 disables
# them, which is what you want for short WhatsApp answers. Raise it only if
# replies feel too shallow. Ignored by non-2.5 models.
GEMINI_THINKING_BUDGET=0

# --- Per-user rate limit ---------------------------------------------------
# A single user gets LLM_RATE_LIMIT questions per LLM_RATE_WINDOW_MINUTES.
# Over the limit they get one short notice telling them when to retry.
LLM_RATE_LIMIT=5
LLM_RATE_WINDOW_MINUTES=60

# --- Hard monthly cap -----------------------------------------------------
# Total tokens (prompt + output + thinking) allowed per calendar month. When
# this is hit the assistant posts one notice and stops until the month rolls
# over. Alerts and digests are unaffected. 0 = no cap (not advised).
# This is the cap you can actually trust - set it to something you are willing
# to spend.
LLM_MONTHLY_CAP=1000000

# Optional USD ceiling, ESTIMATED from the two prices below. Whichever cap
# trips first wins. 0 = no cost cap.
LLM_MONTHLY_COST_CAP=0

# Prices per million tokens, used ONLY to estimate cost for the cap above and
# the /status readout. These are placeholders - check the current numbers for
# your model at https://ai.google.dev/pricing and correct them, otherwise the
# cost figure and LLM_MONTHLY_COST_CAP will be wrong.
LLM_INPUT_PRICE_PER_MTOK=0.30
LLM_OUTPUT_PRICE_PER_MTOK=2.50

# --- Answer shape ---------------------------------------------------------
# How many recent turns of a chat the assistant remembers. Kept in memory
# only and never written to disk. Higher = better follow-ups, more tokens.
LLM_CONTEXT_TURNS=6

# Hard character limit on a reply posted to a group.
LLM_MAX_REPLY_CHARS=1200


# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Prefix for admin commands and /ask.
COMMAND_PREFIX=/

# Randomised delay between automated sends, in milliseconds. This is the main
# anti-ban control: bursts are what get a number flagged. DO NOT set these to
# 0, and do not lower them because a digest feels slow.
SEND_MIN_DELAY_MS=3500
SEND_MAX_DELAY_MS=9000

# How often to check outbox.jsonl for new scraper output, in milliseconds.
# Lower is more responsive; 5s is already well inside the scraper's 2h cycle.
OUTBOX_POLL_MS=5000


# ---------------------------------------------------------------------------
# Branding and links
# ---------------------------------------------------------------------------

# Surfaced when someone asks about a course or about past questions.
QUESTIONSDEY_URL=https://questionsdey.com

# Name the bot uses for itself in /help and in its system prompt.
BOT_NAME=STEEZE SMART BOT


# ---------------------------------------------------------------------------
# Advanced - you should not need these
# ---------------------------------------------------------------------------

# Only used to build display links. Must match the scraper's Sakai instance.
SAKAI_BASE=https://sakai.ug.edu.gh

# trace | debug | info | warn | error
LOG_LEVEL=info


# ===========================================================================
# Deliberately NOT in this file
# ===========================================================================
# SAKAI_USER, SAKAI_PASS, TELEGRAM_TOKEN and TELEGRAM_CHAT_ID belong to the
# scraper only (../Sakai-Assignment-Alerts/.env). Do not copy them here.
#
# This service talks to the public internet and runs an LLM over group
# messages; it has no reason to hold your Sakai password or your Telegram bot
# token, and docker-compose keeps the two environments separate on purpose.
#
# There is also no per-student credential of any kind - not here, not anywhere.
# The bot reads course-level items scraped by one account (yours) and
# identifies group members by WhatsApp number alone.
# ===========================================================================
